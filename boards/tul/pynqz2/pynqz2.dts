/dts-v1/;
#include <xilinx/zynq7000.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>


#include "pynqz2-pinctrl.dtsi"

/ {
	model = "TUL pynqZ2 board";
	compatible = "tul,pynqz2", "xlnx,zynq-7000";

	chosen {
		zephyr,sram = &sram0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,ocm = &ocm_high;
	};

	aliases {

	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <0>;
		};

		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <1>;
		};
	};

	sram0: memory@0 {
		compatible = "mmio-sram";
		reg = <0x00100000 DT_SIZE_M(512)>;
	};

};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	clock-frequency = <100000000>;
	pinctrl-0 = <&pinctrl_uart0_default>;
	pinctrl-names = "default";
};

&gem0 {
    status = "okay";
    phy-handle = <&ethernet_phy>;

	//                                                                                                                                                                                                                                                                                                                                                              rgmii-id" to force explicit internal RX and TX delays */
    //phy-connection-type = "rgmii-id"; 
    phy-connection-type = "internal"; 

	//phy-reset-gpios = <&psgpio_bank1  9 GPIO_ACTIVE_LOW>;
    /* Add this property to ensure the driver handles proper clock tuning */
    //xlnx,has-mdio;

	// /* Force the driver to use Gigabit internal logic structures */
    //link-speed = <XLNX_GEM_LINK_SPEED_100MBIT>;
    
    // /* Set the MDC management divider (typically 48 for standard Zynq systems) */
    // mdc-divider = <XLNX_GEM_MDC_DIVIDER_48>;
	clock-frequency = <125000000>;
	local-mac-address = [00 e0 4c 68 01 01];
};

&gem0_mdio {
    status = "okay";
	
    ethernet_phy: ethernet-phy@0xe000b000 {
        compatible = "ethernet-phy";
		reg = <1>; 
        status = "okay";
    };
};

&psgpio {
	status = "okay";
};
