/dts-v1/;
#include <xilinx/zynq7000.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>


#include "pynqz2-pinctrl.dtsi"

/ {
	model = "TUL pynqZ2 board";
	compatible = "tul,pynqz2", "xlnx,zynq-7000";

	chosen {
		zephyr,sram = &sram0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,ocm = &ocm_high;
	};

	aliases {

	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <0>;
		};

		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <1>;
		};
	};

	sram0: memory@0 {
		compatible = "mmio-sram";
		/* 512 MiB DDR at 0x0; the first 1 MiB is not usable from the CPU */
		reg = <0x00100000 DT_SIZE_M(511)>;
	};

};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	clock-frequency = <100000000>;
	pinctrl-0 = <&pinctrl_uart0_default>;
	pinctrl-names = "default";
};

/*
 * GEM0 is wired to a Realtek RTL8211E-VL over RGMII on MIO 16..27, with
 * MDIO on MIO 52/53. The MIO muxing and the GEM0 RX clock are set up by the
 * FSBL (ps7_init); RGMII delays are provided by the PHY's strap pins.
 */
&gem0 {
	status = "okay";
	phy-handle = <&ethernet_phy>;
	phy-connection-type = "rgmii";

	/*
	 * NOT the TX clock: this is the frequency of the PLL that feeds
	 * GEM0_CLK_CTRL (IO PLL, SRCSEL=0). The driver derives DIVISOR0/1 from
	 * it to produce 125/25/2.5 MHz for 1000/100/10 Mbit/s. The PYNQ-Z2
	 * ps7_init sets the IO PLL to 50 MHz * 20 = 1 GHz.
	 */
	clock-frequency = <1000000000>;
	local-mac-address = [00 e0 4c 68 01 01];
};

&gem0_mdio {
	status = "okay";

	ethernet_phy: ethernet-phy@1 {
		compatible = "ethernet-phy";
		reg = <1>;
		status = "okay";
	};
};

&psgpio {
	status = "okay";
};
